# Copy to .env.local. Only the provider you use needs settings.

# Ollama (default). Runs locally; no key needed.
# OLLAMA_HOST=http://localhost:11434
# Model to use; defaults to the installed chat model Ollama lists first.
# OLLAMA_MODEL=qwen2.5-coder:7b
# Context window per request; raise it for large sets, lower it if RAM is tight.
# OLLAMA_NUM_CTX=16384
# Drawings at a time; match the Ollama server's own OLLAMA_NUM_PARALLEL (default 1).
# OLLAMA_NUM_PARALLEL=1

# Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (Claude Haiku, Sonnet, Opus). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
