# Copy to .env.local and fill in the key for the provider you use.

# Groq (default drawing model). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any Groq chat model id; defaults to openai/gpt-oss-120b.
# GROQ_MODEL=

# Anthropic (Claude Haiku, Sonnet, Opus). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
